# Copy to .env and adjust. docker compose reads it for variable substitution.
#
# With the dev profile, empty secrets fall back to throwaway values. The prod
# profile (notify_relay.settings.prod) refuses to start unless every secret
# below is set, at least 32 characters long, and ALLOWED_HOSTS is explicit.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SETTINGS_MODULE=notify_relay.settings.dev
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

SECRET_KEY=
JWT_SIGNING_KEY=
API_KEY_HASH_PEPPER=
# Each API key gets its own webhook signing secret when it is created; this
# one is only used for keys that have none (e.g. created from a Django shell).
WEBHOOK_HMAC_SECRET=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=0
DEFAULT_FROM_EMAIL=no-reply@notify-relay.internal

WEBHOOK_TIMEOUT_S=10
# Extra CIDRs to refuse on top of the built-in ones (anything that isn't
# globally routable is always refused), e.g. your own public ranges.
WEBHOOK_BLOCKED_NETWORKS=

RATE_LIMIT_ENABLED=1
RATE_LIMIT_DEFAULT_PER_MIN=100
RATE_LIMIT_DEFAULT_BURST=200
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BURST=10
# Trusted reverse proxies in front of the API (per-IP limits then use X-Forwarded-For).
NUM_PROXIES=0

LOG_LEVEL=INFO
LOG_FORMAT=json

# Host ports (bound to 127.0.0.1).
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
